{
  "name": "cross-border-fashion-ai-studio",
  "productName": "AI服装工作台",
  "version": "0.1.7",
  "description": "AI服装图片生产工作台",
  "author": "AI Fashion Workbench",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "dev:electron": "concurrently -k -s first \"next dev -H 127.0.0.1\" \"wait-on http://127.0.0.1:3000/api/health && cross-env ELECTRON_DEV_URL=http://127.0.0.1:3000 electron .\"",
    "build": "next build",
    "build:desktop": "pnpm build && node scripts/prepare-desktop.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "package:win": "pnpm build:desktop && electron-forge package --platform=win32 --arch=x64",
    "make:win": "pnpm build:desktop && electron-forge make --platform=win32 --arch=x64"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "heic-convert": "^2.1.0",
    "jszip": "^3.10.1",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@electron-forge/cli": "7.8.1",
    "@electron-forge/maker-squirrel": "7.8.1",
    "@electron-forge/plugin-auto-unpack-natives": "7.8.1",
    "@next/eslint-plugin-next": "15.5.20",
    "@rushstack/eslint-patch": "1.16.1",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^37.2.4",
    "eslint-import-resolver-node": "0.3.10",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "wait-on": "^8.0.4"
  }
}
