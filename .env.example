# BFL / FLUX VTO
BFL_API_KEY=
BFL_API_BASE_URL=https://api.bfl.ai
BFL_VTO_ENDPOINT=/v1/flux-tools/vto-v1

# FASHN
FASHN_API_KEY=
FASHN_API_BASE_URL=https://api.fashn.ai/v1
FASHN_TRYON_MODEL=tryon-max

# Volcengine / Seedream
# 首选方舟官方环境变量名；VOLCENGINE_API_KEY 保留向后兼容。不要提交真实密钥。
ARK_API_KEY=
VOLCENGINE_API_KEY=
VOLCENGINE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
SEEDREAM_ENDPOINT_ID=
VOLCENGINE_PYTHON_BIN=
VOLCENGINE_PYTHON_BRIDGE=

# FLUX Image Edit (OpenAI-compatible images endpoint expected)
FLUX_API_KEY=
FLUX_API_BASE_URL=
FLUX_KLEIN_MODEL=
FLUX_PRO_MODEL=

# Custom image API (OpenAI-compatible JSON image endpoint)
CUSTOM_IMAGE_API_KEY=
CUSTOM_IMAGE_API_ENDPOINT=
CUSTOM_IMAGE_MODEL=
CUSTOM_TRYON_MODEL=
CUSTOM_POSE_MODEL=
CUSTOM_RECOLOR_MODEL=

# Vision recognition model (OpenAI-compatible chat completions, image input + text output)
# 用于产品图片识别 / QC 质量检查等看图工作流的兜底模型（未在工作台存储绑定时使用）
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# Defaults
# 可选值：默认 Provider 或 custom
TRYON_PROVIDER=bfl
POSE_PROVIDER=volcengine
RECOLOR_PROVIDER=volcengine
AI_REQUEST_TIMEOUT_MS=180000
OUTPUTS_DIR=outputs

# Optional: encrypts API Keys saved from the settings page.
# If empty in local mode, the server creates a private key under data/ automatically.
PROVIDER_SETTINGS_SECRET=

# Optional: comma-separated allowlist for provider image download domains.
# Leave empty to allow any public HTTPS host while still blocking local/private networks.
AI_IMAGE_DOWNLOAD_HOSTS=
